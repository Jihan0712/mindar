// Cloudflare hosting config: serves the built app (dist/) as static files.
// Unknown paths fall back to index.html so links like /ar work when opened directly.
{
  "name": "inrl2",
  "compatibility_date": "2026-10-01",
  // Publish on the free inrl2.<account>.workers.dev address.
  "workers_dev": true,
  // Media requests go through worker/index.ts, which adds byte-range support for iPhone;
  // /api/* is ours too (GIF search; its GIPHY_KEY is a Cloudflare secret, never in the repo).
  "main": "worker/index.ts",
  // Cloud saving (worker/cloud.ts): people's photos and videos in R2, scenes in D1.
  // Both created by Nico in the INRL2 account on 2026-10-06; the worker makes its own tables.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "inrl2-media" }],
  // Who can read reports and remove content (worker/safety.ts): InRL's team, by user name.
  "vars": { "ADMINS": "nico" },
  "d1_databases": [{ "binding": "DB", "database_name": "inrl2-media", "database_id": "d1a438da-765e-4d7e-b209-562299bc8a28" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/test/*.mp4", "/test/*.m4a", "/media/*", "/api/*"]
  }
}
